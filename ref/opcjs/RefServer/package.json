{
  "name": "ref-server",
  "version": "1.0.0",
  "description": "Reference OPC UA server built with opcjs-server, used to exercise RefClient (and, over time, other reference/3rd-party OPC UA clients)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:build": "npm run build && npm start",
    "dev": "tsx index.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "opcua",
    "server",
    "nodejs",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "opcjs-base": "file:../../../packages/base",
    "opcjs-server": "file:../../../packages/server"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
