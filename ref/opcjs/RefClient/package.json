{
  "name": "ref-client",
  "version": "1.0.0",
  "description": "Reference OPC UA client built with opcjs, used to exercise RefServer and other reference/3rd-party OPC UA servers",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:build": "npm run build && npm start",
    "dev": "tsx index.ts",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:dev": "vitest"
  },
  "keywords": [
    "opcua",
    "client",
    "nodejs",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "opcjs-base": "file:../../../packages/base",
    "opcjs-client": "file:../../../packages/client"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  }
}
