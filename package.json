{
  "name": "@your-org/opcuajs",
  "version": "0.1.0",
  "description": "OPC UA JavaScript client library",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "opcua-generator": "./dist/generator/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "workspaces": [
    "packages/base",
    "packages/generator",
    "packages/client",
    "packages/server",
    "packages/e2e"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "npx nx run-many -t build",
    "verify": "npx nx run-many -t verify",
    "test": "npx nx run-many -t test:unit",
    "test:ref": "bash ref/test.sh",
    "graph": "npx nx graph",
    "generate:services": "node ./src/generators/runServicesGenerator.js"
  },
  "keywords": [
    "opcua",
    "opc-ua",
    "client",
    "industrial",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "csv-parse": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^10.0.2",
    "fast-xml-parser": "^5.4.1",
    "nx": "^23.2.1",
    "tsup": "^8.3.5",
    "typescript": "^6.0.2",
    "vitest": "^4.0.18"
  }
}
