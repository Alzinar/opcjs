{
  "name": "opcjs-base",
  "version": "0.0.0",
  "description": "Base functionalities for OPC UA.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iarbre/opcjs.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "lint": "eslint ./src",
    "tsc": "npx tsc --noEmit",
    "tsc:test": "npx tsc -p tsconfig.test.json --noEmit",
    "build": "tsup",
    "verify": "npm run lint && npm run tsc && npm run tsc:test && npm run build && npm run test:unit",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:int": "vitest run tests/integration",
    "test:dev": "vitest",
    "generate": "node ../generator/dist/cli.js ../../../ext/UA-NodeSet/Schema/Opc.Ua.NodeSet2.Services.xml -o src/schema"
  },
  "keywords": [
    "opcua",
    "opc-ua"
  ],
  "author": "slompf18",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.0.2",
    "tsup": "^8.3.5",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@peculiar/x509": "^2.1.0",
    "fast-xml-parser": "^5.4.1",
    "reflect-metadata": "^0.2.2"
  }
}
